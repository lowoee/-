        "指数": 3071,
        "日活": 415
      },
      {
        "月份": "2025-04-01",
        "指数": 3125,
        "日活": 426
      },
      {
        "月份": "2025-05-01",
        "指数": 3160,
        "日活": 433
      },
      {
        "月份": "2025-06-01",
        "指数": 3142,
        "日活": 429
      },
      {
        "月份": "2025-07-01",
        "指数": 3198,
        "日活": 441
