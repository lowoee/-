{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "App 日活跃用户与指数走势高度同步",
    "subtitle": "2025 年月度数据｜来源：模拟数据"
  },
  "width": 520,
  "height": 300,
  "encoding": {
    "x": {
      "field": "月份",
      "type": "temporal",
      "timeUnit": "utcyearmonth",
      "scale": {
        "type": "utc"
      },
      "axis": {
        "format": "%-m月",
        "title": null,
        "labelAngle": 0
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#4C78A8",
        "strokeWidth": 2.5,
        "point": {
          "filled": true,
          "color": "#4C78A8"
        }
      },
      "encoding": {
        "y": {
          "field": "指数",
          "type": "quantitative",
          "scale": {
            "domain": [
              3040,
              3330
            ],
            "zero": false
          },
          "axis": {
            "title": "模拟指数（点）",
            "titleColor": "#4C78A8",
            "labelColor": "#4C78A8"
          }
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#F58518",
        "strokeWidth": 2.5,
        "point": {
          "filled": true,
          "color": "#F58518"
        }
      },
      "encoding": {
        "y": {
          "field": "日活",
          "type": "quantitative",
          "scale": {
            "domain": [
              408,
              470
            ],
            "zero": false
          },
          "axis": {
            "title": "日活跃用户（万人）",
            "orient": "right",
            "titleColor": "#F58518",
            "labelColor": "#F58518",
            "grid": false
          }
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "data": {
    "values": [
      {
        "月份": "2025-01-01",
        "指数": 3052,
        "日活": 412
      },
      {
        "月份": "2025-02-01",
