    ]
  },
  "config": {
    "font": "PingFang SC",
    "background": "#ffffff",
    "padding": 16,
    "title": {
      "fontSize": 16,
      "subtitleFontSize": 12,
      "subtitleColor": "#555555",
      "anchor": "start",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#333333",
      "titleColor": "#333333"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal"
    },
    "view": {
      "stroke": null
    }
  }
